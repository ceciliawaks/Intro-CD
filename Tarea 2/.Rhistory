from sklearn.metrics import (
accuracy_score,
confusion_matrix,
ConfusionMatrixDisplay,
classification_report,
)
ds = load_dataset("tomas-gr/all-the-news-2-1-Component-one-sampled", split="train", cache_dir="../data")
df = ds.to_pandas()
df["date"] = pd.to_datetime(df["date"], format="mixed")
df["year"] = pd.to_numeric(df["year"], errors="coerce")
df["month"] = pd.to_numeric(df["month"], errors="coerce")
df["day"] = pd.to_numeric(df["day"], errors="coerce")
text_columns = [
"author",
"title",
"article",
"url",
"section",
"publication"
]
df[text_columns] = df[text_columns].astype("string")
def clean_text(df, column_name):
# Eliminar encabezado hasta el primer salto de línea
result = df[column_name].str.replace(
r"^[^\n]*\n",
"",
regex=True
)
# Minúsculas
result = result.str.lower()
# Reemplazar puntuación y saltos de línea por espacios
punctuation = re.escape(string.punctuation + "—–¿¡«»")
result = result.str.replace(
f"[{punctuation}\\n]",
" ",
regex=True
)
# Eliminar palabras que contengan caracteres no permitidos
result = result.str.replace(
r"\b\S*[^a-zA-Z\sáéíóúüñ]\S*\b",
"",
regex=True
)
# Eliminar espacios múltiples
result = result.str.replace(
r"\s+",
" ",
regex=True
).str.strip()
return result
top_3_publications = df["publication"].value_counts().head(3).reset_index()
top_3_publications.columns = [
"Medio de prensa",
"Cantidad de artículos"]
df_top_3 = (
df[df["publication"].isin(top_3_publications["Medio de prensa"])]
.copy()
)
df_top_3["CleanText"] = clean_text(df_top_3, "article")
df_top_3 = df_top_3.dropna(
subset=["CleanText", "publication"]
).copy()
# TODO: Particione los datos en train y test (30% test), con muestreo estratificado
X = df_top_3["CleanText"]
y = df_top_3["publication"]
X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.3, random_state=33, stratify=y)
#print(X_train.shape) #10262
#print(X_test.shape) #4398
# TODO: Genere una visualización que muestre la proporción de artículos de cada medio
# en los conjuntos de train y test.
dist_total = y.value_counts(normalize=True);
dist_train = y_train.value_counts(normalize=True);
dist_test = y_test.value_counts(normalize=True);
dist_df = pd.concat(
[dist_total, dist_train, dist_test],
axis=1
);
dist_df.columns = ["Total", "Train", "Test"];
#print(dist_df)
dist_df.plot(
kind="bar",
figsize=(8, 5)
);
plt.ylabel("Proporción");
plt.xlabel("Medio de prensa");
plt.title("Balance de clases");
plt.xticks(rotation=45);
plt.legend();
plt.tight_layout();
plt.show()
# TODO: Transforme el texto de entrenamiento a una representación Bag of Words
# Muestre el tamaño de la matriz resultante
# Muestre un ejemplo: las primeras palabras del vocabulario y sus conteos en un documento
count_vect = CountVectorizer()
X_train_bow = count_vect.fit_transform(X_train)
X_test_bow = count_vect.transform(X_test)
#X_train_bow.shape #(10262, 82287)
#X_test_bow.shape #(4398, 82287)
#print(list(count_vect.vocabulary_.keys())[:20])
#| results: asis
feature_names = count_vect.get_feature_names_out()
fila = 0
# Columnas con valores distintos de cero
columnas = X_train_bow[fila].nonzero()[1][:6]
ejemplo_bow = pd.DataFrame(
X_train_bow[:5][:, columnas].toarray(),
columns=feature_names[columnas]
)
latex_tabla=ejemplo_bow.to_latex(
index=False,
escape=True,
#    column_format="p{0.42\\textwidth}p{0.42\\textwidth}",
