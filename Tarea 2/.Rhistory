rd0 = 0.94863
#a = 0.8458
M = 100
k = np.arange(-M, M+1)
rd = rd0 * (-a)**np.abs(k)
#omega = np.linspace(-np.pi, np.pi, 1000)
Sd = np.zeros_like(omega, dtype=complex)
for i, w in enumerate(omega):
Sd[i] = np.sum(rd * np.exp(-1j*w*k))
plt.figure(figsize=(8,4))
plt.plot(omega, Sd.real)
plt.xlabel(r'$\omega$')
plt.ylabel(r'$S_d(\omega)$')
plt.title('DEP de $d[n]$')
plt.grid(True)
plt.show()
Sx = np.abs(Hc)**2 * Sd
plt.figure(figsize=(10,5))
plt.plot(omega, Sx)
plt.xlabel(r'$\omega$')
plt.ylabel(r'$S_x(\omega)$')
plt.title('DEP de x[n]')
plt.grid(True)
plt.show()
