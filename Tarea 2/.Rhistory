np.sqrt(sigma2_2),
N
)
y = x + v2
#genero d[n] gorro
d_hat = np.zeros(N)
for n in range(3, N):
d_hat[n] = (
w[0]*y[n]
+ w[1]*y[n-1]
+ w[2]*y[n-2]
+ w[3]*y[n-3]
)
fig, axs = plt.subplots(2, 2, figsize=(12, 8))
# Arriba izquierda
axs[0,0].plot(d)
axs[0,0].set_title(r"$d[n]$")
# Abajo izquierda
axs[1,0].plot(d_hat);
axs[1,0].set_title(r"$\hat d[n]$")
# Arriba derecha
axs[0,1].plot(x)
axs[0,1].set_title(r"$x[n]$")
# Abajo derecha
axs[1,1].plot(y)
axs[1,1].set_title(r"$y[n]$")
for ax in axs.flat:
ax.set_xlabel("n")
ax.set_ylabel("Amplitud")
ax.grid(True)
# Misma escala vertical para d y d_hat
ymin = min(d.min(), d_hat.min());
ymax = max(d.max(), d_hat.max());
axs[0,0].set_ylim(ymin, ymax);
axs[1,0].set_ylim(ymin, ymax);
plt.tight_layout()
plt.show()
e = d - d_hat
J = np.mean(e**2)
print("J = ", np.round(J, 5))
#omega = np.linspace(-np.pi, np.pi, 1000)
Hc = 1 / (1 - b*np.exp(-1j*omega))
Hw = (
1/(w[0]
+ w[1]*np.exp(-1j*omega)
+ w[2]*np.exp(-2j*omega)
+ w[3]*np.exp(-3j*omega)
))
plt.figure(figsize=(10,5))
plt.plot(
omega,
np.abs(Hc),
label="Canal"
)
plt.plot(
omega,
np.abs(Hw),
label="Wiener"
)
plt.xlabel(r'$\omega$')
plt.ylabel('Magnitud')
plt.title('Respuesta en frecuencia')
plt.grid(True)
plt.legend()
plt.show()
